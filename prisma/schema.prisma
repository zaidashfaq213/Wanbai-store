// WANBAI-STORE — Prisma schema
// Milestone 3: User Accounts, Wallet & Checkout
//
// Provider: PostgreSQL. Set DATABASE_URL in .env, then:
//   npx prisma migrate dev --name init      (creates tables)
//   npx prisma generate                      (generates the client)
//
// The product catalog itself lives in code (lib/data/*) for now, so orders and
// favorites reference products by their stable `slug` and store a price/name
// snapshot on each order line — this keeps history correct even if the catalog
// changes later, and avoids seeding the whole catalog into the DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) core models — User / Account / Session / tokens
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN // Supervisor — full control panel
  MANAGER // limited staff — Orders (requests) + Payments (deposits) only
}

model User {
  id            String    @id @default(cuid())
  name          String?
  // Unique handle chosen at signup. Optional so OAuth (Google/Facebook)
  // accounts can be created without one and set it later.
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Null for OAuth-only accounts (Google/Facebook). Set for email/password.
  passwordHash  String?
  role          Role      @default(USER)

  // Wallet balance is stored in USD cents to avoid floating-point drift.
  walletBalance Int @default(0)

  // A second, separate balance used only for GSM Services — those are priced
  // and topped up in real USD, unlike the main store wallet above (SDG).
  // Never read/written by anything on the game-top-up side; see
  // GsmWalletTransaction and lib/gsm/create.ts.
  gsmWalletBalance Int @default(0)

  // Preferences mirrored from the storefront selectors.
  preferredLocale   String? // "ar" | "en"
  preferredCurrency String? // e.g. "USD"

  // Re-engagement email tracking (see ReEngagementSettings). Updated
  // (throttled) whenever the user is seen on web or mobile; the cron job
  // reads these to decide who's inactive and who's already been emailed.
  lastActiveAt       DateTime?
  reEngageSentCount  Int       @default(0)
  reEngageLastSentAt DateTime?

  // Expo push token for the mobile app (web has no push equivalent — the
  // dashboard's bell icon + email cover that side). Null until the app
  // registers one; overwritten on every fresh registration since a token can
  // change (reinstall, new device) and only the latest one is ever valid.
  pushToken String?

  accounts              Account[]
  sessions              Session[]
  orders                Order[]
  favorites             Favorite[]
  notifications         Notification[]
  walletTransactions    WalletTransaction[]
  gsmWalletTransactions GsmWalletTransaction[]
  passwordResetTokens   PasswordResetToken[]
  paymentSubmissions    PaymentSubmission[]    @relation("UserSubmissions")
  reviewedSubmissions   PaymentSubmission[]    @relation("ReviewedSubmissions")
  supportTickets        SupportTicket[]
  ticketMessages        TicketMessage[]
  orderMessages         OrderMessage[]
  productReviews        ProductReview[]
  gsmOrders             GsmOrder[]
  gsmOrderNotes         GsmOrderNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// OAuth provider links (Google, Facebook) managed by the Prisma adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Used by Auth.js for email verification flows.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Forgot-password flow: a single-use, expiring token emailed to the user.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the token; the raw token is only emailed
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Signup email verification: a short-lived 6-digit code emailed to the user.
model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String // sha256 of the 6-digit code
  expires   DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

// ---------------------------------------------------------------------------
// Wallet
// ---------------------------------------------------------------------------

enum WalletTxType {
  TOPUP // credit added to the wallet
  PURCHASE // debit for an order paid with wallet
  REFUND // credit returned after a refund
  ADJUSTMENT // manual admin correction
}

model WalletTransaction {
  id          String       @id @default(cuid())
  userId      String
  // Signed amount in USD cents: positive = credit, negative = debit.
  amount      Int
  type        WalletTxType
  description String?
  // Optional link to the order this transaction settled.
  orderId     String?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([orderId])
}

// GSM Services run on their own USD-denominated balance, completely separate
// from the main store wallet (which is SDG) — a customer can have money in
// one and none in the other. Same shape as WalletTransaction, its own table
// so the two histories never mix.
enum GsmWalletTxType {
  TOPUP // bank-transfer top-up approved by an admin
  PURCHASE // spent on a GSM order
  REFUND // credit returned after a rejected/cancelled GSM order
  ADJUSTMENT // manual admin correction
}

model GsmWalletTransaction {
  id          String          @id @default(cuid())
  userId      String
  // Signed amount in USD cents: positive = credit, negative = debit.
  amount      Int
  type        GsmWalletTxType
  description String?
  // Free-text admin note / external transfer reference, shown alongside the
  // transaction in the admin panel — distinct from `description`, which is
  // the system-generated line (e.g. "GSM order GSM-XXXX").
  reference   String?
  // Optional link to the GSM order this transaction settled.
  gsmOrderId  String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gsmOrder GsmOrder? @relation(fields: [gsmOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([gsmOrderId])
}

// ---------------------------------------------------------------------------
// Orders — guest checkout supported (userId is nullable)
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING // created, awaiting payment
  PAID // payment captured
  DELIVERED // codes/top-up delivered
  FAILED // payment or fulfillment failed
  REFUNDED // refunded to wallet / gateway
  CANCELLED
}

enum PaymentMethod {
  WALLET // paid from the in-app wallet balance
  BANK // manual bank transfer + uploaded screenshot, approved by an admin
  GATEWAY // reserved for a future automated gateway
}

model Order {
  id  String @id @default(cuid())
  // Human-friendly reference shown to the customer, e.g. "WB-8F3K2A".
  ref String @unique

  // Null for guest checkout; the email is always captured for delivery.
  userId String?
  email  String

  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod @default(GATEWAY)
  // The last status a "your order is now ..." email was sent for. Lets
  // notifyOrderStatus() skip re-sending when the same status is set again
  // (an admin re-click, a webhook retry, a redundant status update).
  notifiedStatus OrderStatus?

  // Money snapshot in USD cents at time of purchase.
  subtotal Int
  total    Int
  // Currency the customer was viewing (display only; amounts stored in USD).
  currency String @default("USD")
  locale   String @default("ar")

  items              OrderItem[]
  walletTransactions WalletTransaction[]
  paymentSubmissions PaymentSubmission[]
  messages           OrderMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
}

// Chat thread attached to a single order: the customer and the admin talk here
// instead of opening a separate support ticket for every purchase.
model OrderMessage {
  id          String  @id @default(cuid())
  orderId     String
  authorId    String? // null if the author was deleted
  isStaff     Boolean @default(false)
  body        String  @db.Text
  // Seen flags so each side can show an "unread" badge on the thread.
  readByUser  Boolean @default(false)
  readByStaff Boolean @default(false)

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
}

enum DeliveryType {
  TOPUP
  CODE
  SERVICE
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  // Product snapshot (catalog lives in code, referenced by slug).
  productSlug  String
  productName  String
  categorySlug String
  // Selected variant group + package labels, snapshotted for history.
  variantLabel String?
  packageLabel String
  unitPrice    Int // USD cents
  quantity     Int     @default(1)

  deliveryType  DeliveryType
  // Top-up input fields the buyer provided (e.g. { "player-id": "123" }).
  inputs        Json?
  // Delivered code/secret for CODE products, or fulfillment note for others.
  deliveredCode String?
  deliveredAt   DateTime?

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Present only while a provider fulfilment attempt exists for this item.
  gameApiOrder GameApiOrder?

  @@index([orderId])
  @@index([productSlug])
}

// ---------------------------------------------------------------------------
// Favorites / Wishlist
// ---------------------------------------------------------------------------

model Favorite {
  id          String @id @default(cuid())
  userId      String
  productSlug String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productSlug])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Notifications (in-app)
// ---------------------------------------------------------------------------

enum NotificationType {
  ORDER
  WALLET
  PROMO
  SYSTEM
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType @default(SYSTEM)
  title  String
  body   String?
  // Optional deep link, e.g. "/dashboard/orders".
  href   String?
  read   Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

// ---------------------------------------------------------------------------
// Manual payments — bank transfer + uploaded screenshot, reviewed by an admin
// ---------------------------------------------------------------------------

// The store's payout banks (O-Cash, MyCashi, BOK). Admin-editable.
model BankAccount {
  id             String  @id @default(cuid())
  key            String  @unique // "o-cash" | "mycashi" | "bok"
  nameEn         String
  nameAr         String
  accountName    String // account holder to transfer to
  accountNumber  String
  instructionsEn String?
  instructionsAr String?
  color          String? // brand color used on the payment card
  logo           String? @db.Text // uploaded bank logo as a base64 data URL
  active         Boolean @default(true)
  sortOrder      Int     @default(0)
  // Whether this method is offered on the GSM top-up form (customer pays in
  // USD there) — independent of `active`, which gates the main SDG wallet
  // top-up form. A bank can be offered on either, both, or neither.
  forGsm         Boolean @default(false)

  submissions PaymentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentPurpose {
  WALLET_TOPUP // add funds to the (SDG) store wallet
  ORDER // pay for a specific order
  GSM_TOPUP // add funds to the separate USD GSM wallet
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// A customer's proof-of-payment: how much, which bank, and the screenshot.
// Approving it credits the wallet (WALLET_TOPUP) or pays the order (ORDER).
model PaymentSubmission {
  id            String         @id @default(cuid())
  userId        String
  purpose       PaymentPurpose
  amount        Int // USD cents
  bankAccountId String
  senderName    String? // name/number the customer sent from
  reference     String? // optional transfer reference
  proofUrl      String         @db.Text // screenshot stored as a data URL
  status        PaymentStatus  @default(PENDING)
  orderId       String? // set for ORDER submissions
  adminNote     String?
  reviewedById  String?
  reviewedAt    DateTime?

  user        User        @relation("UserSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("ReviewedSubmissions", fields: [reviewedById], references: [id], onDelete: SetNull)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  order       Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Catalog — admin-managed. Prices/products live here (no longer hardcoded).
// ---------------------------------------------------------------------------

enum ProductFulfillment {
  TOPUP
  CODE
  SERVICE
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameEn    String
  nameAr    String
  icon      String // emoji placeholder
  gradient  String // tailwind gradient classes
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String             @id @default(cuid())
  slug            String             @unique
  categoryId      String
  nameEn          String
  nameAr          String
  badgeEn         String
  badgeAr         String
  initial         String
  hue             Int                @default(280)
  priceFrom       Int // "from" price in USD cents
  rating          Float              @default(5)
  reviewCount     Int                @default(0)
  image           String?
  fulfillment     ProductFulfillment @default(CODE)
  overviewEn      String             @db.Text
  overviewAr      String             @db.Text
  howToUseEn      String             @db.Text
  howToUseAr      String             @db.Text
  ratingBreakdown Int[] // [5*,4*,3*,2*,1*]
  active          Boolean            @default(true)
  // Distinct from `active`: an inactive product is hidden from the storefront
  // entirely. An unavailable one stays fully visible/browsable — only the
  // purchase button is disabled, with a status line shown under the price.
  available       Boolean            @default(true)
  sortOrder       Int                @default(0)

  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variantGroups VariantGroup[]
  inputs        ProductInput[]
  faqs          ProductFaq[]
  reviews       ProductReview[]
  // Set when this product auto-fulfils through a provider game (see
  // GameApiGame.productId, which owns the actual unique constraint).
  gameApiGame   GameApiGame?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model VariantGroup {
  id        String    @id @default(cuid())
  productId String
  nameEn    String
  nameAr    String
  sortOrder Int       @default(0)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  packages  Package[]

  @@index([productId])
}

model Package {
  id               String            @id @default(cuid())
  variantGroupId   String
  labelEn          String
  labelAr          String
  sublabelEn       String?
  sublabelAr       String?
  price            Int // USD cents
  // "Was" price for a strikethrough sale display, e.g. /6,250/ 6,000. Kept
  // separate from an "enabled" flag so an admin can pause the sale (hide the
  // strikethrough) without losing the old price they'd typed in.
  compareAtPrice   Int? // USD cents
  compareAtEnabled Boolean           @default(false)
  popular          Boolean           @default(false)
  // Same idea as Product.available, one level down: turning a specific
  // package/tier off disables buying just that one (still shown, greyed
  // out) while every other package on the product keeps selling normally.
  available        Boolean           @default(true)
  sortOrder        Int               @default(0)
  variantGroup     VariantGroup      @relation(fields: [variantGroupId], references: [id], onDelete: Cascade)
  // Set when this exact denomination auto-fulfils through a provider
  // catalogue entry (see GameApiCatalogue.packageId, which owns the
  // unique constraint).
  gameApiCatalogue GameApiCatalogue?

  @@index([variantGroupId])
}

model ProductInput {
  id            String  @id @default(cuid())
  productId     String
  key           String
  labelEn       String
  labelAr       String
  placeholderEn String
  placeholderAr String
  kind          String  @default("text")
  required      Boolean @default(false)
  // When true, this key is suppressed entirely at checkout — including an
  // automatic per-category default with the same key (e.g. Player ID for
  // "game-fill" products), which has no DB row of its own and so could never
  // be removed by deleting a ProductInput before this existed.
  hidden        Boolean @default(false)
  sortOrder     Int     @default(0)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductFaq {
  id        String  @id @default(cuid())
  productId String
  qEn       String
  qAr       String
  aEn       String  @db.Text
  aAr       String  @db.Text
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductReview {
  id        String  @id @default(cuid())
  productId String
  name      String
  rating    Int
  commentEn String
  commentAr String
  date      String
  sortOrder Int     @default(0)
  // Set when a customer submitted the review (seeded ones have no user).
  userId    String?
  approved  Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Milestone 5 — content (CMS pages, blog, help), support tickets, settings
// ---------------------------------------------------------------------------

// CMS pages: about-us, terms-and-conditions, privacy-policy, return-policy,
// cookie-policy, gdpr. Body is plain text/markdown-ish, rendered as paragraphs.
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleEn   String
  titleAr   String
  bodyEn    String   @db.Text
  bodyAr    String   @db.Text
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleEn     String
  titleAr     String
  excerptEn   String
  excerptAr   String
  bodyEn      String   @db.Text
  bodyAr      String   @db.Text
  coverImage  String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Help-center FAQ, grouped by a category key (e.g. "getting-started").
model HelpFaq {
  id          String   @id @default(cuid())
  categoryKey String
  qEn         String
  qAr         String
  aEn         String   @db.Text
  aAr         String   @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryKey])
}

enum TicketStatus {
  OPEN // waiting on support
  ANSWERED // support replied
  CLOSED
}

model SupportTicket {
  id      String       @id @default(cuid())
  ref     String       @unique // e.g. "TK-9F2A"
  userId  String
  subject String
  status  TicketStatus @default(OPEN)

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id       String  @id @default(cuid())
  ticketId String
  authorId String? // null if the author was deleted
  isStaff  Boolean @default(false)
  body     String  @db.Text

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ticketId])
}

// Singleton row (id = "store") holding contact channels shown across the site.
model StoreSettings {
  id             String   @id @default("store")
  // Uploaded site logo as a base64 data URL (same storage model as payment
  // proofs). Falls back to /logo.svg when unset.
  logo           String?  @db.Text
  // Uploaded browser-tab favicon as a base64 data URL. Falls back to the
  // bundled app/icon.svg when unset.
  favicon        String?  @db.Text
  whatsapp       String?
  telegram       String?
  supportEmail   String?
  facebook       String?
  instagram      String?
  youtube        String?
  tiktok         String?
  // Master switch for the G2Bulk game top-up integration (lib/gameapi/). The
  // actual API key lives in the G2BULK_API_KEY env var, never in the DB —
  // this only turns auto-fulfilment on/off. See the Game API admin page.
  gameApiEnabled Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

// "Come back" email — sent to customers inactive for `inactiveDays`, capped
// at `maxSends` total and spaced at least `intervalDays` apart. Read by the
// cron endpoint at app/api/cron/re-engagement.
model ReEngagementSettings {
  id           String   @id @default("reengagement")
  enabled      Boolean  @default(false)
  inactiveDays Int      @default(7)
  maxSends     Int      @default(3)
  intervalDays Int      @default(7)
  subjectEn    String   @default("We miss you! ❤️")
  subjectAr    String   @default("اشتقنا ليك ❤️")
  bodyEn       String   @default("Come back now and top up your favorite games with WANBI STOER 🎮🔥")
  bodyAr       String   @default("تعال الآن واشحن ألعابك المفضلة مع وانبي ستور 🎮🔥")
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Game top-up provider integration (G2Bulk) — auto-fulfils TOPUP orders
// instead of requiring an admin to deliver them by hand. See lib/gameapi/.
// ---------------------------------------------------------------------------

// A game as listed by the provider (synced from GET /v1/games). Optionally
// linked to one of our own Products — that's what turns "just a synced game"
// into "actually sells and auto-delivers on this store".
model GameApiGame {
  id           String             @id @default(cuid())
  code         String             @unique // provider's game code, e.g. "pubgm"
  nameEn       String
  imageUrl     String?
  // Admin can pause auto-fulfilment for a game without unlinking it.
  active       Boolean            @default(true)
  productId    String?            @unique
  product      Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  catalogues   GameApiCatalogue[]
  lastSyncedAt DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// A single denomination under a provider game (synced from GET
// /v1/games/{code}/catalogue). Optionally linked to one of our own Packages —
// that's the mapping used to auto-place a provider order at checkout.
model GameApiCatalogue {
  id                  String   @id @default(cuid())
  gameApiGameId       String
  providerCatalogueId Int // provider's catalogue "id"
  name                String // e.g. "60 UC" — sent back verbatim as catalogue_name
  amount              Float // provider's current cost price in USD
  packageId           String?  @unique
  lastSyncedAt        DateTime @default(now())

  game    GameApiGame @relation(fields: [gameApiGameId], references: [id], onDelete: Cascade)
  package Package?    @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@unique([gameApiGameId, providerCatalogueId])
}

// One attempt to fulfil an OrderItem through the provider. Created the moment
// we call their order-create endpoint; updated by the webhook as the top-up
// progresses. webhookToken is our own unguessable secret (the provider has no
// signature mechanism) embedded in the callback_url we give them, so we can
// trust a callback actually belongs to this order.
model GameApiOrder {
  id              String   @id @default(cuid())
  orderItemId     String   @unique
  providerOrderId Int?
  gameCode        String
  catalogueName   String
  status          String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  webhookToken    String   @unique
  errorMessage    String?  @db.Text
  raw             Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// GSM Services — a deliberately separate storefront (own categories, own
// services, own order pipeline/status set) living inside the same store.
// Shares User accounts, the wallet, and the admin panel shell with the
// Game Top-Up side, but nothing else — no Product/Category/Order rows.
// ---------------------------------------------------------------------------

model GsmCategory {
  id        String       @id @default(cuid())
  slug      String       @unique
  nameEn    String
  nameAr    String
  icon      String // emoji, same convention as Category.icon
  active    Boolean      @default(true)
  sortOrder Int          @default(0)
  services  GsmService[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([slug])
}

model GsmService {
  id               String  @id @default(cuid())
  categoryId       String
  slug             String  @unique
  nameEn           String
  nameAr           String
  price            Int // cents, same convention as Package.price
  descriptionEn    String  @db.Text
  descriptionAr    String  @db.Text
  requirementsEn   String  @db.Text
  requirementsAr   String  @db.Text
  processingTimeEn String // free text, e.g. "1-3 business days"
  processingTimeAr String
  active           Boolean @default(true)
  sortOrder        Int     @default(0)

  category GsmCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  fields   GsmServiceField[]
  orders   GsmOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// Dynamic per-service checkout fields — same idea as ProductInput, plus a
// "file" kind (a real gap in ProductInput: GSM routinely needs a photo of
// the IMEI screen, a proof of purchase, the device itself).
model GsmServiceField {
  id            String  @id @default(cuid())
  serviceId     String
  key           String
  labelEn       String
  labelAr       String
  placeholderEn String
  placeholderAr String
  kind          String  @default("text") // "text" | "number" | "file"
  required      Boolean @default(false)
  sortOrder     Int     @default(0)

  service GsmService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, key])
  @@index([serviceId])
}

enum GsmOrderStatus {
  PENDING // created, wallet not yet charged (shouldn't normally linger — see lib/gsm/create.ts)
  PAID // payment captured, awaiting admin review
  UNDER_REVIEW // admin is checking the submitted details/files
  IN_PROGRESS // work has started
  COMPLETED
  REJECTED
  CANCELLED
}

model GsmOrder {
  id  String @id @default(cuid())
  // Human-friendly reference, e.g. "GSM-8F3K2A" — mirrors Order.ref but its
  // own prefix, so the two are never visually confused in support chats.
  ref String @unique

  userId String
  email  String

  serviceId    String
  // Snapshot at purchase time — a later price/name edit on the service must
  // never rewrite history, same reasoning as OrderItem's product snapshot.
  serviceName  String
  categoryName String
  price        Int // cents, charged from the wallet
  currency     String @default("USD")
  locale       String @default("ar")

  status         GsmOrderStatus  @default(PENDING)
  notifiedStatus GsmOrderStatus?

  // Customer-submitted text/number field answers, keyed by GsmServiceField.key.
  // File-kind answers live in GsmOrderFile instead — a data-URL doesn't
  // belong inlined into a JSON blob queried on every order-list render.
  inputs Json?

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  service    GsmService             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  files      GsmOrderFile[]
  notes      GsmOrderNote[]
  walletTxns GsmWalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model GsmOrderFile {
  id        String   @id @default(cuid())
  orderId   String
  // Base64 data URL — same storage model as payment proofs and product
  // images elsewhere in this schema.
  data      String   @db.Text
  filename  String
  // "customer": part of the original submission (photo of the IMEI, proof
  // of purchase, ...). "admin": the delivered result (unlock file, report,
  // ...) attached when the order is completed.
  source    String // "customer" | "admin"
  fieldKey  String? // which GsmServiceField this answers, when source = customer
  createdAt DateTime @default(now())

  order GsmOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Admin ↔ customer thread on one order — status explanations, requests for
// more info, the final result written up in words. Mirrors OrderMessage.
model GsmOrderNote {
  id       String  @id @default(cuid())
  orderId  String
  authorId String?
  isStaff  Boolean @default(false)
  body     String  @db.Text

  order  GsmOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
}
