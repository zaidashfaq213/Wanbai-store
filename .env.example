# ---------------------------------------------------------------------------
# WANBAI-STORE environment — copy to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Supabase / Neon / Railway / local).
# Example (local): postgresql://postgres:postgres@localhost:5432/wanbai?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wanbai?schema=public"

# Auth.js — REQUIRED. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the app (used for OAuth callbacks + email links).
AUTH_URL="http://localhost:3000"

# --- OAuth providers (optional; leave blank to hide those buttons) ---
# Google:   https://console.cloud.google.com  -> Credentials -> OAuth client
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Facebook: https://developers.facebook.com -> App -> Facebook Login
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# --- SMTP for password-reset emails (Nodemailer) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# From address shown on outgoing mail.
SMTP_FROM="WANBI STOER <no-reply@wanbai.store>"

# --- Cron endpoints (re-engagement email, etc.) ---
# Generate with: openssl rand -hex 32
# Without this set, /api/cron/* always 404s (fails closed).
CRON_SECRET=""

# --- G2Bulk game top-up API (lib/gameapi/) ---
# Get your key from their Telegram bot: @G2BULKBOT
# NEVER put this in the frontend/mobile app — server-only, like a password.
# Auto-fulfilment stays off until it's also enabled on Admin -> Game API.
G2BULK_API_KEY=""
# Only needed if the provider ever changes their API host.
# G2BULK_BASE_URL="https://api.g2bulk.com/v1"
