# ---------------------------------------------------------------------------
# WANBAI-STORE environment — copy to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Supabase / Neon / Railway / local).
# Example (local): postgresql://postgres:postgres@localhost:5432/wanbai?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wanbai?schema=public"

# Auth.js — REQUIRED. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the app (used for OAuth callbacks + email links).
AUTH_URL="http://localhost:3000"

# --- OAuth providers (optional; leave blank to hide those buttons) ---
# Google:   https://console.cloud.google.com  -> Credentials -> OAuth client
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Facebook: https://developers.facebook.com -> App -> Facebook Login
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# --- SMTP for password-reset emails (Nodemailer) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# From address shown on outgoing mail.
SMTP_FROM="WANBAI-STORE <no-reply@wanbai.store>"
